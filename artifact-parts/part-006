        elements.exportData.addEventListener("click", () => void exportBackup());
        elements.copyExport.addEventListener("click", () => void copyExport());
        elements.importData.addEventListener("click", () => void importBackup());

        document.querySelectorAll("[data-close-modal]").forEach((button) => {
          button.addEventListener("click", () => {
            const modal = document.getElementById(button.dataset.closeModal);
            if (modal) closeModal(modal);
          });
        });

        for (const modal of [elements.eventModal, elements.settingsModal]) {
          modal.addEventListener("mousedown", (event) => {
            if (event.target === modal) closeModal(modal);
          });
        }

        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape" && state.activeModal) {
            closeModal(state.activeModal);
            return;
          }
          if (
            state.activeModal === elements.eventModal &&
            (event.metaKey || event.ctrlKey) &&
            event.key === "Enter" &&
            !event.isComposing &&
            event.keyCode !== 229
          ) {
            event.preventDefault();
            elements.eventForm.requestSubmit();
          }
        });

        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "hidden") {
            void flushPending();
            return;
          }
          const now = Date.now();
          if (
            document.visibilityState === "visible" &&
            !state.pendingOperations.length &&
            now - state.lastVisibilityReloadAt > VISIBILITY_RELOAD_THROTTLE_MS
          ) {
            state.lastVisibilityReloadAt = now;
            void reloadCurrentMonth("visibility");
          }
        });

        window.addEventListener("pagehide", () => {
          void flushPending();
        });

        window.addEventListener("beforeunload", (event) => {
          if (!state.pendingOperations.length) return;
          event.preventDefault();
          event.returnValue = "";
        });
      }

      async function init() {
        bindEvents();
        renderColorOptions();
        renderAll();
        await loadMeta();
        await loadMonth(initialMonth, { preserveDate: true, reason: "initial" });
      }

      void init();
    })();
  </script>
</body>
</html>
