      function createMemoryStorage() {
        const memory = new Map();
        return {
          async get(key) {
            if (!memory.has(key)) {
              const error = new Error("Key not found");
              error.code = "KEY_NOT_FOUND";
              throw error;
            }
            return { key, value: memory.get(key), shared: false };
          },
          async set(key, value) {
