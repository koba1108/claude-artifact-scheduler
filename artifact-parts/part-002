            return { key, value, shared: false };
          },
          async delete(key) {
            const deleted = memory.delete(key);
            return { key, deleted, shared: false };
          },
          async list(prefix = "") {
            const keys = [...memory.keys()].filter((key) => key.startsWith(prefix)).sort();
            return { keys, prefix, shared: false };
          }
        };
