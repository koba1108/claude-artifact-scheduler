              <p>この日の予定はまだありません。右下の「予定を追加」から登録できます。</p>
            </div>
          `;
          elements.eventList.append(empty);
          return;
        }

        for (const event of events) {
          const button = document.createElement("button");
          button.type = "button";
          button.className = "event-item";
          button.style.setProperty("--event-color", COLORS[event.color]?.value || COLORS.blue.value);
          button.setAttribute("aria-label", `${event.title}を編集`);

          const time = document.createElement("span");
          time.className = "event-time";
          time.textContent = eventTimeLabel(event);
          time.style.whiteSpace = "pre-line";

          const content = document.createElement("span");
          content.className = "event-content";
          const title = document.createElement("span");
          title.className = "event-title";
          title.textContent = event.title || "(タイトルなし)";
          content.append(title);
          if (event.memo) {
            const memo = document.createElement("span");
            memo.className = "event-memo";
            memo.textContent = event.memo;
            content.append(memo);
          }

          const chevron = document.createElement("span");
          chevron.className = "chevron";
          chevron.textContent = "›";
          chevron.setAttribute("aria-hidden", "true");

          button.append(time, content, chevron);
          button.addEventListener("click", () => openEventModal(event));
          elements.eventList.append(button);
        }
      }

      function renderAll() {
        renderSync();
        renderCalendar();
        renderDay();
        elements.previewNotice.hidden = hasNativeStorage;
        const busy = state.switchingMonth;
        elements.prevMonth.disabled = busy;
        elements.nextMonth.disabled = busy;
        elements.reload.disabled = busy;
        elements.addEvent.disabled = busy;
      }

      async function getStorageValue(key) {
        try {
          const result = await storage.get(key);
          if (!result || typeof result.value !== "string") {
            throw new Error("window.storage.get の結果が不正です");
          }
          return { ok: true, found: true, value: result.value };
        } catch (getError) {
          try {
            const listed = await storage.list(key);
            if (listed == null || !Array.isArray(listed.keys)) {
              throw new Error("window.storage.list の結果が不正です");
            }
            if (listed.keys.includes(key)) {
              return {
                ok: false,
                found: true,
                error: new Error(`保存済みキーの取得に失敗しました: ${getError?.message || getError}`)
              };
            }
            return { ok: true, found: false, value: null };
          } catch (listError) {
            return {
              ok: false,
              found: false,
              error: new Error(`取得に失敗し、キーの存在確認もできませんでした: ${listError?.message || listError}`)
            };
          }
        }
      }

      async function setStorageValue(key, value) {
        const size = new TextEncoder().encode(value).byteLength;
        if (size >= STORAGE_VALUE_LIMIT_BYTES) {
          throw new Error(`保存データが安全上限4.5MBを超えています (${Math.ceil(size / 1024)}KB)`);
        }
        const result = await storage.set(key, value);
        if (result == null) throw new Error("window.storage.set が null を返しました");
        return result;
      }

      async function recoverBrokenMonth(month, rawValue, cause) {
        const backup = brokenKey(month);
        try {
          await setStorageValue(backup, typeof rawValue === "string" ? rawValue : JSON.stringify(rawValue));
        } catch (backupError) {
          console.error("Broken-data backup failed", backupError);
          throw new Error(
            `破損データを検出しましたが退避に失敗したため、元キーの初期化を中止しました: ${backupError?.message || backupError}`
          );
        }

        const fresh = emptyMonth(month);
        try {
          await setStorageValue(monthKey(month), JSON.stringify(fresh));
        } catch (resetError) {
          console.error("Broken-data reset failed", resetError);
          throw new Error(
            `破損データは ${backup} へ退避しましたが、元キーの初期化に失敗しました: ${resetError?.message || resetError}`
          );
        }

        state.syncNote = `${cause.message || "JSONの読み込みに失敗しました。"} 破損データを ${backup} に退避して空データへ戻しました。`;
        return fresh;
      }

      async function readMonth(month) {
        const result = await getStorageValue(monthKey(month));
        if (!result.ok) throw result.error;
        if (!result.found) {
          return {
            data: emptyMonth(month),
            note: hasNativeStorage
              ? "初回データです。最初の予定を保存すると月キーを作成します。"
              : "プレビューモードの初回データです。"
          };
        }

        try {
          return {
            data: normalizeMonthData(parseStorageValue(result.value), month),
            note: ""
          };
        } catch (error) {
          return {
            data: await recoverBrokenMonth(month, result.value, error),
            note: state.syncNote
          };
        }
      }

      async function loadMeta() {
        const result = await getStorageValue(META_KEY);
        if (!result.ok) {
          console.warn("Meta load failed", result.error);
          return;
        }
        if (!result.found) return;
        try {
          state.meta = normalizeMeta(parseStorageValue(result.value));
          state.sessionDeviceName = state.meta.deviceName || "";
        } catch (error) {
          console.warn("Meta parse failed", error);
          state.meta = emptyMeta();
        }
      }

      async function loadMonth(month, { preserveDate = false, reason = "manual" } = {}) {
        setStatus("loading", reason === "visibility" ? "最新データを確認中…" : "読み込み中…", "");
        try {
          const { data, note } = await readMonth(month);
          state.currentMonth = month;
          state.monthData = data;
          state.lastFetchedAt = Date.now();
          state.syncNote = note;

          if (!preserveDate || !state.selectedDate.startsWith(`${month}-`)) {
            state.selectedDate = today.startsWith(`${month}-`) ? today : `${month}-01`;
          }

          const statusKind = note ? "warning" : "saved";
          const statusMessage = data.updatedAt ? "最新データを取得" : "初回データ（未保存）";
          setStatus(statusKind, statusMessage, note);
          renderAll();
          return true;
        } catch (error) {
          console.error("Month load failed", error);
          setStatus(
            "error",
            "読み込み失敗",
            `既存の画面内容を保持しています。再読み込みしてください。${error?.message ? ` (${error.message})` : ""}`
          );
          renderAll();
          return false;
        }
      }

      function applyEventLocally(event) {
        state.monthData.events = mergeEvents(state.monthData.events, [event]);
        state.monthData.updatedAt = event.updatedAt;
        state.monthData.updatedBy = deviceLabel();
      }

      function enqueueEvent(event) {
        applyEventLocally(event);
        state.operationSequence += 1;
        state.pendingOperations.push({ sequence: state.operationSequence, event: clone(event) });
        setStatus("pending", "保存待ち…", "");
        renderCalendar();
        renderDay();
        scheduleSave();
      }

      function scheduleSave() {
        clearTimeout(state.saveTimer);
        state.saveTimer = setTimeout(() => {
          state.saveTimer = null;
          void flushPending();
        }, SAVE_DEBOUNCE_MS);
      }

      async function prepareRemoteMonth(month) {
        const result = await getStorageValue(monthKey(month));
        if (!result.ok) throw result.error;
        if (!result.found) return emptyMonth(month);
        try {
          return normalizeMonthData(parseStorageValue(result.value), month);
        } catch (error) {
          return recoverBrokenMonth(month, result.value, error);
        }
      }

      async function flushPending() {
        clearTimeout(state.saveTimer);
        state.saveTimer = null;
        if (!state.pendingOperations.length) return true;
        if (state.savePromise) return state.savePromise;

        const month = state.currentMonth;
        const batch = state.pendingOperations.slice();
        const batchSequences = new Set(batch.map((operation) => operation.sequence));

        state.savePromise = (async () => {
          setStatus("saving", "保存中…", "");
          try {
            const remote = await prepareRemoteMonth(month);
            let events = mergeEvents(remote.events, state.monthData.events);
            for (const operation of batch) {
              events = mergeEvents(events, [operation.event]);
            }
            events = cleanTombstones(events);

            const now = Date.now();
            const next = {
              schemaVersion: SCHEMA_VERSION,
              updatedAt: now,
              updatedBy: deviceLabel(),
              events
            };
            await setStorageValue(monthKey(month), JSON.stringify(next));

            state.pendingOperations = state.pendingOperations.filter(
              (operation) => !batchSequences.has(operation.sequence)
            );
            const remainingEvents = state.pendingOperations.map((operation) => operation.event);
            state.monthData = {
              ...next,
              month,
              events: mergeEvents(next.events, remainingEvents)
            };
            state.lastFetchedAt = Date.now();
            setStatus("saved", state.pendingOperations.length ? "一部保存済み" : "保存完了", "");
            renderAll();

            if (state.pendingOperations.length) scheduleSave();
            return true;
          } catch (error) {
            console.error("Save failed", error);
            setStatus(
              "error",
              "保存失敗",
              `未保存の変更をこの画面に保持しています。閉じると失われます。${error?.message ? ` (${error.message})` : ""}`
            );
            renderAll();
            return false;
          } finally {
            state.savePromise = null;
          }
        })();

        return state.savePromise;
      }

      async function switchMonth(month) {
        if (state.switchingMonth || month === state.currentMonth) return;
        state.switchingMonth = true;
        renderAll();
        const saved = await flushPending();
        if (!saved) {
          state.switchingMonth = false;
          renderAll();
          showToast("未保存の変更があるため月を移動できません。再試行してください。");
          return;
        }
        await loadMonth(month);
        state.switchingMonth = false;
        renderAll();
      }

      async function reloadCurrentMonth(reason = "manual") {
        if (state.switchingMonth) return;
        state.switchingMonth = true;
        renderAll();
        const saved = await flushPending();
        if (!saved) {
          state.switchingMonth = false;
          renderAll();
          return;
        }
        await loadMonth(state.currentMonth, { preserveDate: true, reason });
        state.switchingMonth = false;
        renderAll();
      }

      function openModal(element) {
        state.previousFocus = document.activeElement;
        state.activeModal = element;
        element.hidden = false;
        document.body.style.overflow = "hidden";
        requestAnimationFrame(() => {
          const target = element.querySelector("input:not([type=hidden]), textarea, button");
          target?.focus();
        });
      }

      function closeModal(element) {
        element.hidden = true;
        state.activeModal = null;
        document.body.style.overflow = "";
        state.previousFocus?.focus?.();
      }

      function renderColorOptions(selected = "blue") {
        elements.colorList.textContent = "";
        for (const [key, color] of Object.entries(COLORS)) {
          const label = document.createElement("label");
          label.className = "color-option";
          label.innerHTML = `
            <input type="radio" name="event-color" value="${key}" ${key === selected ? "checked" : ""} />
