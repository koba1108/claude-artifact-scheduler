    .day-cell:hover { background: var(--surface-soft); }
    .day-cell[data-empty="true"] { cursor: default; }
    .day-cell[data-empty="true"]:hover { background: transparent; }
    .day-cell[data-sunday="true"] .day-number { color: #df5163; }
    .day-cell[data-saturday="true"] .day-number { color: #4d6ddd; }

    .day-cell[data-selected="true"] {
      background: var(--primary-soft);
    }

    .day-cell[data-selected="true"] .day-number {
      color: #fff;
      background: var(--primary);
      box-shadow: 0 7px 18px rgba(77, 95, 231, 0.3);
    }

    .day-cell[data-today="true"]:not([data-selected="true"]) .day-number {
      outline: 2px solid rgba(77, 95, 231, 0.24);
      outline-offset: 2px;
    }

    .day-number {
      display: grid;
      width: 36px;
      height: 36px;
      place-items: center;
      border-radius: 50%;
      font-size: 14px;
      font-weight: 800;
    }

    .event-dots {
      position: absolute;
      right: 0;
      bottom: 5px;
      left: 0;
      display: flex;
      min-height: 6px;
      justify-content: center;
      gap: 3px;
    }

    .event-dot {
      width: 5px;
      height: 5px;
      border-radius: 50%;
      background: var(--dot-color, var(--primary));
    }

    .day-card { overflow: hidden; }

    .day-card-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 18px 18px 14px;
      border-bottom: 1px solid var(--line);
    }

    .eyebrow {
      margin: 0 0 3px;
      color: var(--muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .day-title {
      margin: 0;
      font-size: clamp(20px, 5.4vw, 25px);
      font-weight: 850;
      letter-spacing: -0.025em;
    }

    .count-badge {
      flex: 0 0 auto;
      padding: 7px 10px;
      border-radius: 999px;
      color: var(--muted);
      background: var(--surface-soft);
      font-size: 12px;
      font-weight: 750;
    }

    .event-list {
      display: grid;
      gap: 9px;
      padding: 12px;
    }

    .event-item {
      position: relative;
      display: grid;
      grid-template-columns: 68px minmax(0, 1fr) 24px;
      gap: 10px;
      align-items: start;
      width: 100%;
      overflow: hidden;
      border: 1px solid var(--line);
      border-radius: 16px;
      padding: 13px 12px 13px 15px;
      color: inherit;
      text-align: left;
      background: #fff;
      cursor: pointer;
    }

    .event-item::before {
      position: absolute;
      top: 0;
      bottom: 0;
      left: 0;
      width: 4px;
      background: var(--event-color, var(--primary));
      content: "";
    }

    .event-time {
      color: var(--muted);
      font-size: 12px;
      font-weight: 750;
      line-height: 1.45;
    }

    .event-content { min-width: 0; }

    .event-title {
      margin: 0;
      overflow-wrap: anywhere;
      font-size: 15px;
      font-weight: 800;
      line-height: 1.4;
    }

    .event-memo {
      display: -webkit-box;
      margin: 4px 0 0;
      overflow: hidden;
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.45;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 2;
    }

    .chevron {
      color: #a2abc0;
      font-size: 22px;
      line-height: 1;
    }

    .empty-state {
      display: grid;
      min-height: 170px;
      place-items: center;
      padding: 28px 22px;
      color: var(--muted);
      text-align: center;
    }

    .empty-state-icon {
      display: grid;
      width: 52px;
      height: 52px;
      margin: 0 auto 13px;
      place-items: center;
      border-radius: 50%;
      color: var(--primary);
      background: var(--primary-soft);
      font-size: 24px;
    }

    .empty-state p {
      max-width: 360px;
      margin: 0;
      font-size: 13px;
      line-height: 1.7;
    }

    .action-dock {
      position: fixed;
      z-index: 25;
      right: max(12px, calc((100vw - 760px) / 2 + 12px));
      bottom: var(--safe-bottom);
      left: max(12px, calc((100vw - 760px) / 2 + 12px));
      display: flex;
      align-items: center;
      justify-content: space-between;
      pointer-events: none;
    }

    .action-dock > * { pointer-events: auto; }

    .settings-button {
      display: grid;
      width: 48px;
      height: 48px;
      place-items: center;
      border: 1px solid var(--line);
      border-radius: 14px;
      color: var(--ink);
      background: rgba(255, 255, 255, 0.96);
      box-shadow: 0 12px 30px rgba(31, 43, 73, 0.13);
      cursor: pointer;
    }

    .add-button {
      display: inline-flex;
      min-height: 52px;
      align-items: center;
      gap: 8px;
      border: 0;
      border-radius: 16px;
      padding: 0 18px;
      color: #fff;
      background: var(--primary);
      box-shadow: 0 14px 30px rgba(77, 95, 231, 0.27);
      font-size: 15px;
      font-weight: 800;
      cursor: pointer;
    }

    .add-button:disabled { opacity: 0.48; cursor: not-allowed; }
    .add-button .plus { font-size: 24px; font-weight: 400; line-height: 1; }

    .modal-layer {
      position: fixed;
      z-index: 100;
      inset: 0;
      display: grid;
      align-items: end;
      padding: 14px;
      background: rgba(20, 28, 48, 0.42);
      backdrop-filter: blur(5px);
    }

    .modal-panel {
      width: min(100%, 620px);
      max-height: min(90vh, 760px);
      margin: 0 auto;
      overflow: auto;
      border: 1px solid rgba(226, 230, 240, 0.9);
      border-radius: 24px;
      background: #fff;
      box-shadow: 0 25px 80px rgba(20, 28, 48, 0.25);
      overscroll-behavior: contain;
    }

    .modal-head {
      position: sticky;
      top: 0;
      z-index: 2;
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 17px 18px;
      border-bottom: 1px solid var(--line);
      background: rgba(255, 255, 255, 0.96);
      backdrop-filter: blur(10px);
    }

    .modal-title {
      margin: 0;
      font-size: 19px;
      font-weight: 850;
    }

    .close-button {
      display: grid;
      width: 36px;
      height: 36px;
      place-items: center;
      border: 0;
      border-radius: 50%;
      color: var(--muted);
      background: var(--surface-soft);
      font-size: 22px;
      cursor: pointer;
    }

    .modal-body { padding: 17px 18px 20px; }
    .form-grid { display: grid; gap: 15px; }

    .field { display: grid; gap: 7px; }

    .field-label {
      color: #44506a;
      font-size: 13px;
      font-weight: 750;
    }

    .field-hint {
      margin: -2px 0 0;
      color: var(--muted);
      font-size: 11.5px;
      line-height: 1.45;
    }

    .input,
    .textarea,
    .select {
      width: 100%;
      border: 1px solid #d9deeb;
      border-radius: 13px;
      padding: 12px 13px;
      color: var(--ink);
      background: #fff;
      outline: none;
      transition: border 120ms ease, box-shadow 120ms ease;
    }

    .input:focus,
    .textarea:focus,
    .select:focus {
      border-color: rgba(77, 95, 231, 0.75);
      box-shadow: 0 0 0 4px rgba(77, 95, 231, 0.1);
    }

    .input:disabled { color: #9aa4b8; background: #f2f4f8; }
    .textarea { min-height: 96px; resize: vertical; line-height: 1.55; }
    .textarea.backup { min-height: 150px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 12px; }

    .time-row {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      gap: 9px;
      align-items: center;
    }

    .time-separator { color: var(--muted); }

    .check-row {
      display: flex;
      align-items: center;
      gap: 9px;
      color: #44506a;
      font-size: 14px;
      font-weight: 700;
    }

    .check-row input { width: 19px; height: 19px; accent-color: var(--primary); }

    .color-list {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
    }

    .color-option { position: relative; }
    .color-option input { position: absolute; opacity: 0; pointer-events: none; }

    .color-chip {
      display: inline-flex;
      align-items: center;
      gap: 7px;
      border: 1px solid var(--line);
      border-radius: 999px;
      padding: 8px 11px;
      color: #4b566d;
      background: #fff;
      font-size: 12px;
      font-weight: 750;
      cursor: pointer;
    }

    .color-option input:checked + .color-chip {
      border-color: var(--primary);
      color: var(--primary);
      background: var(--primary-soft);
      box-shadow: 0 0 0 2px rgba(77, 95, 231, 0.08);
    }

    .color-swatch {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: var(--swatch);
    }

    .form-error {
      min-height: 20px;
      margin: 0;
      color: var(--danger);
      font-size: 12.5px;
      line-height: 1.5;
    }

    .modal-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      justify-content: flex-end;
      padding-top: 3px;
    }

    .button {
      min-height: 44px;
      border: 0;
      border-radius: 13px;
      padding: 0 15px;
      font-size: 14px;
      font-weight: 800;
      cursor: pointer;
    }

    .button:disabled { opacity: 0.45; cursor: not-allowed; }
    .button-primary { color: #fff; background: var(--primary); }
    .button-secondary { color: #46516a; background: #eef1f6; }
    .button-danger { margin-right: auto; color: var(--danger); background: var(--danger-soft); }
    .button-outline { border: 1px solid var(--line); color: #46516a; background: #fff; }

    .settings-section {
      display: grid;
      gap: 12px;
      padding: 16px 0;
      border-bottom: 1px solid var(--line);
    }

    .settings-section:first-child { padding-top: 0; }
    .settings-section:last-child { border-bottom: 0; padding-bottom: 0; }

    .section-title {
      margin: 0;
      font-size: 15px;
      font-weight: 850;
    }

    .section-copy {
      margin: -5px 0 0;
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.6;
    }

    .inline-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .settings-status {
      min-height: 20px;
      margin: 0;
      color: var(--muted);
      font-size: 12.5px;
      line-height: 1.5;
    }

    .toast {
      position: fixed;
      z-index: 200;
      right: 18px;
      bottom: calc(84px + var(--safe-bottom));
      left: 18px;
      width: min(calc(100% - 36px), 520px);
      margin: 0 auto;
      border-radius: 14px;
      padding: 12px 14px;
      color: #fff;
      background: rgba(24, 34, 56, 0.94);
      box-shadow: 0 15px 40px rgba(20, 28, 48, 0.2);
      font-size: 13px;
      line-height: 1.5;
      animation: toast-in 180ms ease-out;
    }

    @keyframes toast-in {
      from { transform: translateY(8px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }

    @media (min-width: 620px) {
      .app-shell { padding-inline: 18px; }
      .modal-layer { align-items: center; }
      .calendar-card { padding: 15px 18px 20px; }
      .day-cell { min-height: 68px; }
      .day-number { width: 40px; height: 40px; }
      .event-list { padding: 15px 18px 18px; }
      .event-item { grid-template-columns: 82px minmax(0, 1fr) 24px; padding-block: 15px; }
    }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after {
        scroll-behavior: auto !important;
        animation-duration: 0.01ms !important;
        animation-iteration-count: 1 !important;
        transition-duration: 0.01ms !important;
      }
    }
  </style>
</head>
<body>
  <div class="app-shell" id="app">
    <header class="topbar" aria-label="月の移動">
      <button class="icon-button" id="prev-month" type="button" aria-label="前の月">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18l-6-6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <h1 class="topbar-title" id="month-title">読み込み中</h1>
      <button class="icon-button" id="next-month" type="button" aria-label="次の月">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 18l6-6-6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <button class="icon-button" id="reload" type="button" aria-label="この月を再読み込み">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11a8.1 8.1 0 10.5 3M20 4v7h-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
    </header>

    <main class="stack">
      <section class="card sync-card" aria-live="polite" aria-label="同期ステータス">
        <div class="sync-head">
